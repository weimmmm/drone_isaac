from __future__ import annotations

import math

import torch
import isaaclab.sim as sim_utils
from isaaclab.assets import Articulation, ArticulationCfg, AssetBaseCfg, RigidObjectCfg
from isaaclab.envs import ManagerBasedRLEnv, ManagerBasedRLEnvCfg
from isaaclab.envs.mdp.commands import UniformPoseCommandCfg
from isaaclab.managers import ActionTerm, ActionTermCfg
from isaaclab.managers import ObservationGroupCfg as ObsGroup
from isaaclab.managers import ObservationTermCfg as ObsTerm
from isaaclab.managers import RewardTermCfg as RewTerm
from isaaclab.managers import TerminationTermCfg as DoneTerm
from isaaclab.scene import InteractiveSceneCfg
from isaaclab.sensors.camera import TiledCameraCfg
from isaaclab.terrains import TerrainImporterCfg
from isaaclab.utils import configclass
from isaaclab.utils.math import subtract_frame_transforms

from assets.omninxt.omninxt import OMNINXT_CFG
from controller import CrazyflieController, config as controller_config


MAX_SHARED_OBSTACLES = 100


def _quat_to_euler_deg(quat_w: torch.Tensor) -> torch.Tensor:
    w, x, y, z = quat_w[:, 0], quat_w[:, 1], quat_w[:, 2], quat_w[:, 3]
    sinr_cosp = 2.0 * (w * x + y * z)
    cosr_cosp = 1.0 - 2.0 * (x * x + y * y)
    roll = torch.atan2(sinr_cosp, cosr_cosp)
    sinp = 2.0 * (w * y - z * x)
    pitch = torch.asin(torch.clamp(sinp, -1.0, 1.0))
    siny_cosp = 2.0 * (w * z + x * y)
    cosy_cosp = 1.0 - 2.0 * (y * y + z * z)
    yaw = torch.atan2(siny_cosp, cosy_cosp)
    return torch.rad2deg(torch.stack([roll, pitch, yaw], dim=1))


def _get_target_world(env, env_ids=None):
    if env_ids is None:
        env_ids = slice(None)
    if hasattr(env, "_target_positions_w") and env._target_positions_w is not None:
        return env._target_positions_w[env_ids]
    robot_pos = env.scene["robot"].data.root_pos_w[env_ids]
    return torch.zeros_like(robot_pos)


def _get_cmd_vel_b(env, env_ids=None):
    if env_ids is None:
        env_ids = slice(None)
    if hasattr(env, "_cmd_vel_b"):
        return env._cmd_vel_b[env_ids]
    robot_pos = env.scene["robot"].data.root_pos_w[env_ids]
    return torch.zeros((robot_pos.shape[0], 3), device=robot_pos.device, dtype=robot_pos.dtype)


def _get_target_reached(env, env_ids=None):
    if env_ids is None:
        env_ids = slice(None)
    if hasattr(env, "_target_reached"):
        return env._target_reached[env_ids]
    robot_pos = env.scene["robot"].data.root_pos_w[env_ids]
    return torch.zeros(robot_pos.shape[0], dtype=torch.bool, device=robot_pos.device)


def _state_obs(env):
    robot = env.scene["robot"]
    target_world = _get_target_world(env)
    target_pos_b, _ = subtract_frame_transforms(
        robot.data.root_pos_w, robot.data.root_quat_w, target_world
    )
    ang_vel_obs = (robot.data.root_ang_vel_b * env.cfg.ang_vel_obs_scale).clamp(-2.0, 2.0)
    target_pos_obs = (target_pos_b * env.cfg.target_pos_obs_scale).clamp(
        -env.cfg.target_pos_obs_clip, env.cfg.target_pos_obs_clip
    )
    cmd_obs = (_get_cmd_vel_b(env) * env._cmd_obs_scale).clamp(-1.0, 1.0)
    return torch.cat(
        [
            robot.data.root_lin_vel_b,
            ang_vel_obs,
            robot.data.projected_gravity_b,
            target_pos_obs,
            cmd_obs,
            _get_target_reached(env).float().unsqueeze(1),
        ],
        dim=-1,
    )


def _depth_obs(env):
    if not hasattr(env, "_depth_frame_stack"):
        return torch.zeros(
            (
                env.num_envs,
                env.cfg.num_stacked_depth_frames,
                env.cfg.depth_camera_height,
                env.cfg.depth_camera_width,
            ),
            device=env.device,
        )
    return env._get_stacked_depth_images()


def _compute_min_obstacle_distance(env) -> torch.Tensor:
    if not hasattr(env, "_obstacle_positions_w") or env._obstacle_positions_w is None:
        return torch.full((env.num_envs,), env.cfg.depth_camera_far_clip, device=env.device)
    drone_pos_w = env.scene["robot"].data.root_pos_w
    obstacle_pos_w = env._obstacle_positions_w[: env.cfg.num_obstacles]
    radial_dist = torch.linalg.norm(
        drone_pos_w[:, None, :2] - obstacle_pos_w[None, :, :2], dim=2
    ) - env.cfg.obstacle_radius
    vertical_dist = torch.abs(
        drone_pos_w[:, None, 2] - obstacle_pos_w[None, :, 2]
    ) - (env.cfg.obstacle_height / 2.0)
    outside_radial = radial_dist.clamp_min(0.0)
    outside_vertical = vertical_dist.clamp_min(0.0)
    outside_dist = torch.sqrt(outside_radial.square() + outside_vertical.square())
    inside_dist = torch.minimum(torch.maximum(radial_dist, vertical_dist), torch.zeros_like(radial_dist))
    return (outside_dist + inside_dist).min(dim=1).values


def _reward_vel_tracking(env):
    robot = env.scene["robot"]
    velocity_cmd_frame = torch.stack(
        [
            robot.data.root_lin_vel_b[:, 0],
            robot.data.root_lin_vel_b[:, 1],
            robot.data.root_lin_vel_w[:, 2],
        ],
        dim=1,
    )
    vel_tracking_sq_error = torch.sum(torch.square(_get_cmd_vel_b(env) - velocity_cmd_frame), dim=1)
    return torch.exp(-env.cfg.vel_tracking_exp_scale * vel_tracking_sq_error)


def _reward_ang_vel(env):
    return torch.sum(torch.square(env.scene["robot"].data.root_ang_vel_b), dim=1)


def _reward_distance_to_target(env):
    target_world = _get_target_world(env)
    distance_to_target = torch.linalg.norm(target_world - env.scene["robot"].data.root_pos_w, dim=1)
    return 1 - torch.tanh(distance_to_target / 2.0)


def _reward_target_velocity(env):
    robot = env.scene["robot"]
    target_world = _get_target_world(env)
    target_direction = target_world - robot.data.root_pos_w
    target_direction = target_direction / torch.linalg.norm(target_direction, dim=1, keepdim=True).clamp_min(1e-6)
    return torch.sum(robot.data.root_lin_vel_w * target_direction, dim=1).clamp(min=0.0, max=1.5)


def _reward_progress(env):
    target_world = _get_target_world(env)
    distance_to_target = torch.linalg.norm(target_world - env.scene["robot"].data.root_pos_w, dim=1)
    if not hasattr(env, "_prev_dist_to_target"):
        return torch.zeros_like(distance_to_target)
    progress = (env._prev_dist_to_target - distance_to_target).clamp(-1.0, 1.0)
    env._prev_dist_to_target = distance_to_target.clone()
    return progress


def _reward_target_bonus(env):
    target_world = _get_target_world(env)
    distance_to_target = torch.linalg.norm(target_world - env.scene["robot"].data.root_pos_w, dim=1)
    reached = (distance_to_target < env.cfg.target_reach_threshold) & (~env._target_reached)
    bonus = torch.zeros(env.num_envs, device=env.device)
    if reached.any():
        bonus[reached] = env.cfg.target_reached_bonus / env.step_dt
        env._target_reached[reached] = True
    return bonus


def _reward_obstacle_proximity(env):
    min_obstacle_dist = _compute_min_obstacle_distance(env)
    return torch.where(
        min_obstacle_dist < 1.0,
        torch.exp(-min_obstacle_dist * 3.0),
        torch.zeros_like(min_obstacle_dist),
    )


def _terminated_crash(env):
    robot = env.scene["robot"]
    too_low = robot.data.root_pos_w[:, 2] < 0.1
    too_high = robot.data.root_pos_w[:, 2] > 2.5
    collision = _compute_min_obstacle_distance(env) < env._collision_threshold
    return too_low | too_high | collision


def _terminated_success(env):
    return _get_target_reached(env)


@configclass
class CrazyflieVelocityActionCfg(ActionTermCfg):
    class_type: type[ActionTerm] = None
    asset_name: str = "robot"
    cmd_body_vel_xy_max: float = 0.6
    cmd_vel_z_max: float = 0.6

    def __post_init__(self):
        try:
            super().__post_init__()
        except AttributeError:
            pass
        if self.class_type is None:
            self.class_type = CrazyflieVelocityAction


class CrazyflieVelocityAction(ActionTerm):
    cfg: CrazyflieVelocityActionCfg

    def __init__(self, cfg: CrazyflieVelocityActionCfg, env: ManagerBasedRLEnv) -> None:
        super().__init__(cfg, env)
        self._robot: Articulation = env.scene[self.cfg.asset_name]
        self._controller = CrazyflieController(
            num_envs=env.num_envs,
            device=env.device,
            attitude_dt=env.step_dt,
            position_dt=env.step_dt,
        )
        self._raw_actions = torch.zeros((env.num_envs, 3), device=env.device)
        self._cmd_vel_b = torch.zeros((env.num_envs, 3), device=env.device)
        env._cmd_vel_b = self._cmd_vel_b
        try:
            self._body_idx = self._robot.find_bodies("body")[0]
        except Exception:
            self._body_idx = 0

    @property
    def action_dim(self) -> int:
        return 3

    @property
    def raw_actions(self) -> torch.Tensor:
        return self._raw_actions

    @property
    def processed_actions(self) -> torch.Tensor:
        return self._cmd_vel_b

    def reset_idx(self, env_ids: torch.Tensor | None = None):
        position = self._robot.data.root_pos_w
        attitude = _quat_to_euler_deg(self._robot.data.root_quat_w)
        self._controller.reset({"position": position, "attitude": attitude}, env_ids=env_ids)
        if env_ids is None:
            self._raw_actions.zero_()
            self._cmd_vel_b.zero_()
            env_ids = slice(None)
        else:
            self._raw_actions[env_ids] = 0.0
            self._cmd_vel_b[env_ids] = 0.0
        self._controller.set_velocity_setpoint(
            vx=torch.zeros(self.num_envs if env_ids == slice(None) else len(env_ids), device=self.device),
            vy=torch.zeros(self.num_envs if env_ids == slice(None) else len(env_ids), device=self.device),
            vz=torch.zeros(self.num_envs if env_ids == slice(None) else len(env_ids), device=self.device),
            velocity_body=True,
            env_ids=None if env_ids == slice(None) else env_ids,
        )

    def process_actions(self, actions: torch.Tensor):
        self._raw_actions[:] = actions.clamp(-1.0, 1.0)
        self._cmd_vel_b[:, :2] = self._raw_actions[:, :2] * self.cfg.cmd_body_vel_xy_max
        self._cmd_vel_b[:, 2] = self._raw_actions[:, 2] * self.cfg.cmd_vel_z_max
        self._controller.set_velocity_setpoint(
            vx=self._cmd_vel_b[:, 0],
            vy=self._cmd_vel_b[:, 1],
            vz=self._cmd_vel_b[:, 2],
            velocity_body=True,
        )

    def apply_actions(self):
        state = {
            "position": self._robot.data.root_pos_w,
            "velocity": self._robot.data.root_lin_vel_w,
            "attitude": _quat_to_euler_deg(self._robot.data.root_quat_w),
            "angular_velocity": torch.rad2deg(self._robot.data.root_ang_vel_b),
        }
        force, torque = self._controller.compute(state)
        self._robot.set_external_force_and_torque(
            force.unsqueeze(1), torque.unsqueeze(1), body_ids=self._body_idx
        )


CrazyflieVelocityActionCfg.class_type = CrazyflieVelocityAction


def _shared_obstacle_cfg(idx: int, radius: float, height: float) -> RigidObjectCfg:
    return RigidObjectCfg(
        prim_path=f"/World/SharedObstacles/Obstacle_{idx:03d}",
        spawn=sim_utils.CuboidCfg(
            size=(radius * 2, radius * 2, height),
            collision_props=sim_utils.CollisionPropertiesCfg(collision_enabled=False),
            visual_material=sim_utils.PreviewSurfaceCfg(diffuse_color=(0.8, 0.2, 0.2)),
        ),
        init_state=RigidObjectCfg.InitialStateCfg(pos=(0.0, 0.0, -10.0)),
    )


@configclass
class SharedSceneCfg(InteractiveSceneCfg):
    terrain = TerrainImporterCfg(
        prim_path="/World/ground",
        terrain_type="plane",
        collision_group=-1,
        physics_material=sim_utils.RigidBodyMaterialCfg(
            friction_combine_mode="multiply",
            restitution_combine_mode="multiply",
            static_friction=1.0,
            dynamic_friction=1.0,
            restitution=0.0,
        ),
        debug_vis=False,
    )

    dome_light = AssetBaseCfg(
        prim_path="/World/Light",
        spawn=sim_utils.DomeLightCfg(intensity=2000.0, color=(0.75, 0.75, 0.75)),
    )

    robot: ArticulationCfg = OMNINXT_CFG.replace(prim_path="{ENV_REGEX_NS}/Robot")

    depth_camera: TiledCameraCfg = TiledCameraCfg(
        prim_path="{ENV_REGEX_NS}/Robot/body/front_depth_camera",
        update_period=0.0,
        height=24,
        width=32,
        data_types=["depth"],
        depth_clipping_behavior="max",
        offset=TiledCameraCfg.OffsetCfg(
            pos=(0.10, 0.0, 0.03),
            rot=(0.5, -0.5, 0.5, -0.5),
            convention="ros",
        ),
        spawn=sim_utils.PinholeCameraCfg(
            focal_length=12.0,
            focus_distance=4.0,
            horizontal_aperture=20.955,
            clipping_range=(0.2, 8.0),
        ),
    )

    for idx in range(MAX_SHARED_OBSTACLES):
        locals()[f"shared_obstacle_{idx:03d}"] = _shared_obstacle_cfg(idx, 0.15, 1.5)
    del idx


@configclass
class ActionsCfg:
    control_action = CrazyflieVelocityActionCfg(
        asset_name="robot",
        cmd_body_vel_xy_max=0.6,
        cmd_vel_z_max=0.6,
    )


@configclass
class ObservationsCfg:
    @configclass
    class PolicyCfg(ObsGroup):
        state = ObsTerm(func=_state_obs)
        depth = ObsTerm(func=_depth_obs)

        def __post_init__(self):
            self.concatenate_terms = False

    policy: PolicyCfg = PolicyCfg()


@configclass
class CommandsCfg:
    goal_command = UniformPoseCommandCfg(
        asset_name="robot",
        body_name="body",
        resampling_time_range=(1e6, 1e6),
        debug_vis=False,
        ranges=UniformPoseCommandCfg.Ranges(
            pos_x=(0.0, 0.0),
            pos_y=(0.0, 0.0),
            pos_z=(0.0, 0.0),
            yaw=(0.0, 0.0),
            roll=(0.0, 0.0),
            pitch=(0.0, 0.0),
        ),
    )


@configclass
class RewardsCfg:
    vel_tracking = RewTerm(func=_reward_vel_tracking, weight=0.5)
    ang_vel = RewTerm(func=_reward_ang_vel, weight=-0.01)
    distance_to_target = RewTerm(func=_reward_distance_to_target, weight=8.0)
    target_velocity = RewTerm(func=_reward_target_velocity, weight=4.0)
    target_bonus = RewTerm(func=_reward_target_bonus, weight=1.0)
    obstacle_proximity = RewTerm(func=_reward_obstacle_proximity, weight=-3.0)
    progress = RewTerm(func=_reward_progress, weight=15.0)


@configclass
class TerminationsCfg:
    time_out = DoneTerm(func=lambda env: env.episode_length_buf >= env.max_episode_length - 1, time_out=True)
    died = DoneTerm(func=_terminated_crash)
    success = DoneTerm(func=_terminated_success)


@configclass
class EventCfg:
    pass


@configclass
class QuadcopterSharedMapEnvCfg(ManagerBasedRLEnvCfg):
    episode_length_s = 90.0
    decimation = 2
    scene: SharedSceneCfg = SharedSceneCfg(num_envs=8, env_spacing=0.0, replicate_physics=True)
    actions: ActionsCfg = ActionsCfg()
    observations: ObservationsCfg = ObservationsCfg()
    commands: CommandsCfg = CommandsCfg()
    rewards: RewardsCfg = RewardsCfg()
    terminations: TerminationsCfg = TerminationsCfg()
    events: EventCfg = EventCfg()

    num_obstacles = 20
    target_reach_threshold = 0.5
    depth_camera_width = 32
    depth_camera_height = 24
    num_stacked_depth_frames = 2
    ang_vel_obs_scale = 0.25
    target_pos_obs_scale = 0.1
    target_pos_obs_clip = 2.0
    depth_camera_near_clip = 0.2
    depth_camera_far_clip = 8.0
    obstacle_height = 1.5
    obstacle_radius = 0.15
    obstacle_spawn_range = 15.0
    obstacle_safe_zone = 1.0
    obstacle_min_separation = 0.6
    spawn_edge_distance = 20.0
    target_spawn_range = 20.0
    target_min_height = 0.5
    target_max_height = 2.5
    spawn_min_height = 0.5
    spawn_max_height = 2.5
    is_finite_horizon = False

    def __post_init__(self):
        self.sim = sim_utils.SimulationCfg(
            dt=1 / 100,
            render_interval=self.decimation,
            physics_material=sim_utils.RigidBodyMaterialCfg(
                friction_combine_mode="multiply",
                restitution_combine_mode="multiply",
                static_friction=1.0,
                dynamic_friction=1.0,
                restitution=0.0,
            ),
        )
        self.viewer.eye = (-30.0, 0.0, 35.0)
        self.viewer.lookat = (0.0, 0.0, 0.0)


class QuadcopterSharedMapEnv(ManagerBasedRLEnv):
    cfg: QuadcopterSharedMapEnvCfg

    def load_managers(self):
        print("[DEBUG][SharedManagerEnv] load_managers start", flush=True)
        super().load_managers()
        print("[DEBUG][SharedManagerEnv] load_managers done", flush=True)

    def __init__(self, cfg: QuadcopterSharedMapEnvCfg, render_mode: str | None = None, **kwargs):
        print("[DEBUG][SharedManagerEnv] __init__ start", flush=True)
        super().__init__(cfg, render_mode, **kwargs)
        print("[DEBUG][SharedManagerEnv] super().__init__ done", flush=True)

        self._cmd_obs_scale = torch.tensor(
            [
                1.0 / self.cfg.actions.control_action.cmd_body_vel_xy_max,
                1.0 / self.cfg.actions.control_action.cmd_body_vel_xy_max,
                1.0 / self.cfg.actions.control_action.cmd_vel_z_max,
            ],
            device=self.device,
        )
        self._target_positions_w = torch.zeros((self.num_envs, 3), device=self.device)
        self._target_reached = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
        self._prev_dist_to_target = torch.zeros(self.num_envs, device=self.device)
        self._cmd_vel_b = torch.zeros((self.num_envs, 3), device=self.device)
        self._depth_frame_stack = torch.zeros(
            self.num_envs,
            self.cfg.num_stacked_depth_frames,
            self.cfg.depth_camera_height,
            self.cfg.depth_camera_width,
            device=self.device,
        )
        self._depth_stack_needs_fill = torch.ones(self.num_envs, dtype=torch.bool, device=self.device)
        self._last_depth_stack_update_step = -1
        self._collision_threshold = 0.05
        self._episode_sums = torch.zeros(self.num_envs, device=self.device)
        self._obstacle_positions_w = torch.zeros((MAX_SHARED_OBSTACLES, 3), device=self.device)
        self._shared_obstacles = [self.scene[f"shared_obstacle_{idx:03d}"] for idx in range(MAX_SHARED_OBSTACLES)]
        print("[DEBUG][SharedManagerEnv] obstacle handles ready", flush=True)
        self._randomize_shared_obstacles()
        print("[DEBUG][SharedManagerEnv] shared obstacles randomized", flush=True)

        all_env_ids = torch.arange(self.num_envs, device=self.device, dtype=torch.long)
        print("[DEBUG][SharedManagerEnv] initial reset start", flush=True)
        self._reset_idx(all_env_ids)
        print("[DEBUG][SharedManagerEnv] initial reset done", flush=True)
        self.scene.write_data_to_sim()
        self.sim.forward()
        if self.sim.has_rtx_sensors() and self.cfg.rerender_on_reset:
            self.sim.render()
        self.obs_buf = self.observation_manager.compute(update_history=True)
        print("[DEBUG][SharedManagerEnv] initial observations computed", flush=True)

        print("[INFO] Shared-map quadcopter env with original CrazyflieController")
        print(f"[INFO] OmniNxt controller mass: {controller_config.CF_MASS:.4f} kg")

    def _sample_edge_positions(self, num_samples: int, lateral_range: float, min_height: float, max_height: float):
        side_indices = torch.randint(0, 4, (num_samples,), device=self.device)
        side_signs = torch.where(
            side_indices % 2 == 0,
            torch.ones(num_samples, device=self.device),
            -torch.ones(num_samples, device=self.device),
        )
        lateral = torch.empty(num_samples, device=self.device).uniform_(-lateral_range, lateral_range)
        heights = torch.empty(num_samples, device=self.device).uniform_(min_height, max_height)
        positions = torch.zeros(num_samples, 3, device=self.device)
        x_side_mask = side_indices < 2
        y_side_mask = ~x_side_mask
        positions[x_side_mask, 0] = lateral[x_side_mask]
        positions[x_side_mask, 1] = side_signs[x_side_mask] * self.cfg.spawn_edge_distance
        positions[y_side_mask, 0] = side_signs[y_side_mask] * self.cfg.spawn_edge_distance
        positions[y_side_mask, 1] = lateral[y_side_mask]
        positions[:, 2] = heights
        return positions

    def _randomize_shared_obstacles(self):
        print("[DEBUG][SharedManagerEnv] _randomize_shared_obstacles start", flush=True)
        placed_xy = torch.zeros((self.cfg.num_obstacles, 2), device=self.device)
        min_separation = self.cfg.obstacle_min_separation
        for obstacle_idx in range(self.cfg.num_obstacles):
            chosen_xy = None
            chosen_score = None
            for _ in range(64):
                candidate_xy = torch.empty(2, device=self.device).uniform_(
                    -self.cfg.obstacle_spawn_range, self.cfg.obstacle_spawn_range
                )
                candidate_radius = torch.linalg.norm(candidate_xy, dim=0)
                valid = candidate_radius >= (self.cfg.obstacle_safe_zone + self.cfg.obstacle_radius + 0.2)
                if obstacle_idx == 0:
                    min_dist = torch.tensor(float("inf"), device=self.device)
                else:
                    distances = torch.linalg.norm(candidate_xy.unsqueeze(0) - placed_xy[:obstacle_idx], dim=1)
                    min_dist = distances.min()
                    valid = bool(valid and (min_dist >= min_separation))
                if chosen_xy is None:
                    chosen_xy = candidate_xy
                    chosen_score = min_dist if valid else torch.tensor(-1.0, device=self.device)
                else:
                    candidate_score = min_dist if valid else torch.tensor(-1.0, device=self.device)
                    if candidate_score > chosen_score:
                        chosen_xy = candidate_xy
                        chosen_score = candidate_score
                if valid:
                    chosen_xy = candidate_xy
                    break
            placed_xy[obstacle_idx] = chosen_xy

        self._obstacle_positions_w[:, :2] = 0.0
        self._obstacle_positions_w[:, 2] = -10.0
        self._obstacle_positions_w[: self.cfg.num_obstacles, :2] = placed_xy
        self._obstacle_positions_w[: self.cfg.num_obstacles, 2] = self.cfg.obstacle_height / 2

        for obstacle_idx, obstacle_obj in enumerate(self._shared_obstacles):
            root_state = obstacle_obj.data.default_root_state.clone()
            if root_state.dim() == 1:
                root_state = root_state.unsqueeze(0)
            root_state[:, :3] = self._obstacle_positions_w[obstacle_idx]
            root_state[:, 3] = 1.0
            root_state[:, 4:] = 0.0
            obstacle_obj.write_root_state_to_sim(root_state)
        print("[DEBUG][SharedManagerEnv] _randomize_shared_obstacles complete", flush=True)

    def _get_depth_image(self) -> torch.Tensor:
        if not hasattr(self, "_debug_depth_log_once"):
            self._debug_depth_log_once = False
        if not self._debug_depth_log_once:
            print("[DEBUG][SharedManagerEnv] reading depth image", flush=True)
        depth = self.scene["depth_camera"].data.output["depth"].squeeze(-1)
        depth = torch.nan_to_num(
            depth,
            nan=self.cfg.depth_camera_far_clip,
            posinf=self.cfg.depth_camera_far_clip,
            neginf=self.cfg.depth_camera_near_clip,
        )
        depth = depth.clamp(self.cfg.depth_camera_near_clip, self.cfg.depth_camera_far_clip)
        depth_proximity = 1.0 - (
            (depth - self.cfg.depth_camera_near_clip)
            / (self.cfg.depth_camera_far_clip - self.cfg.depth_camera_near_clip)
        )
        if not self._debug_depth_log_once:
            print(f"[DEBUG][SharedManagerEnv] depth image ready: {tuple(depth_proximity.shape)}", flush=True)
            self._debug_depth_log_once = True
        return depth_proximity.clamp(0.0, 1.0).unsqueeze(1)

    def _get_stacked_depth_images(self) -> torch.Tensor:
        current_depth = self._get_depth_image()
        if self.common_step_counter != self._last_depth_stack_update_step:
            initialized_mask = ~self._depth_stack_needs_fill
            if initialized_mask.any():
                self._depth_frame_stack[initialized_mask] = torch.roll(
                    self._depth_frame_stack[initialized_mask], shifts=-1, dims=1
                )
                self._depth_frame_stack[initialized_mask, -1] = current_depth[initialized_mask, 0]
            self._last_depth_stack_update_step = self.common_step_counter
        if self._depth_stack_needs_fill.any():
            fill_mask = self._depth_stack_needs_fill
            self._depth_frame_stack[fill_mask] = current_depth[fill_mask].expand(
                -1, self.cfg.num_stacked_depth_frames, -1, -1
            )
            self._depth_stack_needs_fill[fill_mask] = False
        return self._depth_frame_stack

    def _reset_idx(self, env_ids):
        print(f"[DEBUG][SharedManagerEnv] _reset_idx start count={len(env_ids)}", flush=True)
        super()._reset_idx(env_ids)
        print("[DEBUG][SharedManagerEnv] super()._reset_idx done", flush=True)
        n = len(env_ids)

        self._target_reached[env_ids] = False
        self._cmd_vel_b[env_ids] = 0.0
        self._depth_stack_needs_fill[env_ids] = True

        start_pos = self._sample_edge_positions(
            n, self.cfg.target_spawn_range, self.cfg.spawn_min_height, self.cfg.spawn_max_height
        )
        goal_pos = self._sample_edge_positions(
            n, self.cfg.target_spawn_range, self.cfg.target_min_height, self.cfg.target_max_height
        )

        self._target_positions_w[env_ids] = goal_pos
        print("[DEBUG][SharedManagerEnv] targets sampled", flush=True)

        robot = self.scene["robot"]
        root_state = robot.data.default_root_state[env_ids].clone()
        root_state[:, :3] = start_pos
        diff = goal_pos - start_pos
        yaw = torch.atan2(diff[:, 1], diff[:, 0])
        half_yaw = yaw * 0.5
        root_state[:, 3] = torch.cos(half_yaw)
        root_state[:, 4] = 0.0
        root_state[:, 5] = 0.0
        root_state[:, 6] = torch.sin(half_yaw)
        root_state[:, 7:13] = 0.0
        robot.write_root_state_to_sim(root_state, env_ids)
        robot.write_joint_state_to_sim(
            robot.data.default_joint_pos[env_ids],
            robot.data.default_joint_vel[env_ids],
            env_ids=env_ids,
        )
        print("[DEBUG][SharedManagerEnv] robot state written", flush=True)
        if hasattr(self.action_manager, "_terms") and "control_action" in self.action_manager._terms:
            self.action_manager._terms["control_action"].reset_idx(env_ids)
            print("[DEBUG][SharedManagerEnv] action term reset", flush=True)
        self._prev_dist_to_target[env_ids] = torch.linalg.norm(goal_pos - start_pos, dim=1)
        print("[DEBUG][SharedManagerEnv] _reset_idx complete", flush=True)

    def step(self, action: torch.Tensor):
        obs, rew, terminated, truncated, extras = super().step(action)
        self._prev_dist_to_target = torch.linalg.norm(
            self._target_positions_w - self.scene["robot"].data.root_pos_w, dim=1
        )
        dones = terminated | truncated
        if dones.any():
            if "log" not in extras:
                extras["log"] = {}
            extras["log"]["Metrics/success_rate"] = self._target_reached[dones].float().mean()
            extras["log"]["Episode_Termination/died"] = _terminated_crash(self)[dones].float().sum()
            extras["log"]["Episode_Termination/time_out"] = truncated[dones].float().sum()
        return obs, rew, terminated, truncated, extras
